diff --git a/ggml/src/ggml-cpu/srv-dgpu.inc b/ggml/src/ggml-cpu/srv-dgpu.inc
new file mode 100644
index 0000000..57aa010
--- /dev/null
+++ b/ggml/src/ggml-cpu/srv-dgpu.inc
@@ -0,0 +1,84 @@
+// SR-HPM dGPU co-verifier: the discrete GPU computes the first rows of the IQ4_XS / Q3_K matrix products of the
+// layers kept in RAM, reading a pinned copy of those rows over PCIe (zero copy, no VRAM for weights), while the CPU
+// threads compute the other rows. The GPU sits idle while the CPU layers run, and PCIe adds ~6 GB/s of weight
+// reads on top of the CPU's ~22 GB/s without slowing it (f3/dgpu/dgpu_bw.cpp).
+// Kernels in srhpm_dgpu.dll (f3/dgpu/dgpu.cu), loaded at run time from the directory of this DLL.
+//   GGML_SRV_DGPU=<fraction of the rows>   one value for every batch size, or one per batch size 1..8
+//                                          (e.g. 0,0,0,0,0,0.12,0.16,0.2); off when unset
+// With 4 tokens the CPU already reads ~35 GB/s of the ~38 the RAM gives, so PCIe reads only compete with it; from 6
+// tokens on the CPU is compute-bound (20-25 GB/s) and the GPU's rows are a net gain (8 tokens: -15 % per product)
+//   GGML_SRV_DGPU_MAX=<GB>                 cap on the pinned copies (default 3)
+#if defined(_WIN32)
+
+struct srv_dgpu_t {
+    bool   ok   = false;
+    double frac[9] = {};  // per batch size
+    size_t max_pinned = (size_t) 3 << 30;
+    int (*launch)(int, const void *, const void *, int64_t, int64_t, int, const float *, size_t, size_t) = nullptr;
+    int (*collect)(int, int64_t, char *, size_t) = nullptr;
+
+    srv_dgpu_t() {
+        const char * e = getenv("GGML_SRV_DGPU");
+        if (!e) {
+            return;
+        }
+        int n = 0;
+        for (const char * p = e; *p && n < 8; n++) {
+            frac[n + 1] = atof(p);
+            p = strchr(p, ',');
+            if (!p) {
+                break;
+            }
+            p++;
+        }
+        if (n == 0) {
+            for (int m = 2; m <= 8; m++) {
+                frac[m] = frac[1];
+            }
+        }
+        bool any = false;
+        for (int m = 1; m <= 8; m++) {
+            any = any || frac[m] > 0;
+        }
+        if (!any) {
+            return;
+        }
+        if (const char * m = getenv("GGML_SRV_DGPU_MAX")) {
+            max_pinned = (size_t) (atof(m) * (1 << 30));
+        }
+        // next to this DLL
+        HMODULE self = nullptr;
+        GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR) &srv_dgpu_dummy, &self);
+        char path[MAX_PATH] = {};
+        GetModuleFileNameA(self, path, MAX_PATH);
+        if (char * s = strrchr(path, '\\')) {
+            strcpy(s + 1, "srhpm_dgpu.dll");
+        }
+        HMODULE h = LoadLibraryA(path);
+        if (!h) {
+            fprintf(stderr, "srv_dgpu: cannot load %s\n", path);
+            return;
+        }
+        auto init = (int (*)()) GetProcAddress(h, "dgpu_init");
+        launch    = (decltype(launch)) GetProcAddress(h, "dgpu_launch");
+        collect   = (decltype(collect)) GetProcAddress(h, "dgpu_collect");
+        ok = init && launch && collect && init() == 0;
+        if (auto mi = (void (*)(size_t *, size_t *)) GetProcAddress(h, "dgpu_mem_info")) {
+            size_t fr = 0, tot = 0;
+            mi(&fr, &tot);
+            fprintf(stderr, "srv_dgpu: VRAM free %.0f MiB of %.0f MiB\n", fr / 1048576.0, tot / 1048576.0);
+        }
+        fprintf(stderr, "srv_dgpu: %s, share of the rows for 1..8 tokens: %.2f %.2f %.2f %.2f %.2f %.2f %.2f %.2f, pinned cap %.1f GB\n",
+                ok ? "on" : "init failed", frac[1], frac[2], frac[3], frac[4], frac[5], frac[6], frac[7], frac[8],
+                max_pinned / 1073741824.0);
+    }
+    static void srv_dgpu_dummy() {}
+};
+
+static srv_dgpu_t & srv_dgpu() {
+    static srv_dgpu_t g;
+    return g;
+}
+
+#endif
diff --git a/ggml/src/ggml-cpu/srv-igpu.inc b/ggml/src/ggml-cpu/srv-igpu.inc
new file mode 100644
index 0000000..8ef83d5
--- /dev/null
+++ b/ggml/src/ggml-cpu/srv-igpu.inc
@@ -0,0 +1,372 @@
+// SR-HPM: the integrated GPU as a second verifier for the weights in system RAM (GGML_SRV_IGPU=1, Windows, OpenCL).
+//
+// When a verification pass multiplies 5 or more tokens, the CPU kernels are compute-bound (an IQ4_XS matrix runs at
+// ~17 GB/s with 8 tokens) and leave half of the DRAM bandwidth unused, while the integrated GPU sits idle on the same
+// memory controller. Measured on a Ryzen 7 5800H: the iGPU alone streams RAM at 38 GB/s, and with the CPU at 8 tokens
+// both together reach ~35 GB/s. So each such matrix product is split by rows: the iGPU takes the first rows (from an
+// interleaved copy of them, read in place through CL_MEM_USE_HOST_PTR) and the CPU threads the rest.
+//
+// The iGPU works on the f32 activations (no activation quantization), so its rows differ from the CPU's by float
+// rounding. Types: IQ4_XS and the C4 re-encodings of IQ3_S / IQ3_XXS. OpenCL is loaded at run time; without it, or
+// with the variable unset, nothing changes.
+#pragma once
+#if defined(_WIN32)
+#define CL_TARGET_OPENCL_VERSION 120
+#include "srhpm-cl/CL/cl.h"
+#ifndef NOMINMAX
+#    define NOMINMAX
+#endif
+#include <windows.h>
+#include <chrono>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <vector>
+
+namespace ggml::cpu::repack {
+
+static const char * srv_igpu_src = R"CLC(
+// KIND 0: IQ4_XS super-blocks (136 bytes: d, scales_h, scales_l[4], qs[128]); KIND 1/2/3: C4 (140 bytes: qs[128],
+// int8 sc[8], float d) with the IQ3_S / IQ3_XXS / IQ4_XS value tables. Weights interleaved by groups of 64 rows:
+// super-block ib of row 64 g + l at ((g nsb + ib) 64 + l) BS. R row groups per work-item, T tokens.
+#if KIND == 0
+#define BS 136
+#else
+#define BS 140
+#endif
+__kernel __attribute__((reqd_work_group_size(64, 1, 1)))
+void mv(__global const uchar * W, __global const float * X, __global float * Y, const int nsb, const int K, const int nr) {
+    __local float xs[T * 256];
+    __local float kv[16];
+    const int lid = get_local_id(0);
+    if (lid < 16) {
+#if KIND == 1
+        const float KV[16] = { 1.f, 3.f, 5.f, 7.f, 9.f, 11.f, 13.f, 15.f, -1.f, -3.f, -5.f, -7.f, -9.f, -11.f, -13.f, -15.f };
+#elif KIND == 2
+        const float KV[16] = { 4.f, 12.f, 20.f, 28.f, 36.f, 44.f, 52.f, 62.f, -4.f, -12.f, -20.f, -28.f, -36.f, -44.f, -52.f, -62.f };
+#else
+        const float KV[16] = { -127.f, -104.f, -83.f, -65.f, -49.f, -35.f, -22.f, -10.f, 1.f, 13.f, 25.f, 38.f, 53.f, 69.f, 89.f, 113.f };
+#endif
+        kv[lid] = KV[lid];
+    }
+    const int ng = (nr + 63) / 64;
+    float acc[R][T];
+    for (int j = 0; j < R; j++) for (int t = 0; t < T; t++) acc[j][t] = 0.f;
+    __global const uchar * gp[R];
+    for (int j = 0; j < R; j++) gp[j] = W + (size_t) min((int) get_group_id(0) * R + j, ng - 1) * nsb * 64 * BS + lid * BS;
+    for (int ib = 0; ib < nsb; ib++) {
+        barrier(CLK_LOCAL_MEM_FENCE);
+        for (int i = lid; i < T * 256; i += 64) xs[i] = X[(i >> 8) * K + ib * 256 + (i & 255)];
+        barrier(CLK_LOCAL_MEM_FENCE);
+        float dl8[R][8];
+        __global const uchar * qsb[R];
+        for (int j = 0; j < R; j++) {
+            __global const uchar * sb = gp[j] + (size_t) ib * 64 * BS;
+#if KIND == 0
+            const uint2 hd = vload2(0, (__global const uint *) sb);
+            const float d  = vload_half(0, (__global const half *) sb);
+            const uint  sh = hd.x >> 16, sl = hd.y;
+            for (int b = 0; b < 8; b++) dl8[j][b] = d * (float) ((int) (((sl >> (4 * b)) & 15) | (((sh >> (2 * b)) & 3) << 4)) - 32);
+            qsb[j] = sb + 8;
+#else
+            const float d  = *(__global const float *) (sb + 136);
+            const char8 sc = vload8(0, (__global const char *) (sb + 128));
+            dl8[j][0] = d * sc.s0; dl8[j][1] = d * sc.s1; dl8[j][2] = d * sc.s2; dl8[j][3] = d * sc.s3;
+            dl8[j][4] = d * sc.s4; dl8[j][5] = d * sc.s5; dl8[j][6] = d * sc.s6; dl8[j][7] = d * sc.s7;
+            qsb[j] = sb;
+#endif
+        }
+        for (int b = 0; b < 8; b++) {
+            uint4 q4[R];
+            for (int j = 0; j < R; j++) q4[j] = vload4(0, (__global const uint *) (qsb[j] + 16 * b));
+            for (int i = 0; i < 4; i++) {
+                float4 wl[R], wh[R];
+                for (int j = 0; j < R; j++) {
+                    const uint  c  = i == 0 ? q4[j].x : i == 1 ? q4[j].y : i == 2 ? q4[j].z : q4[j].w;
+                    const float dl = dl8[j][b];
+                    wl[j].s0 = kv[c & 15] * dl;         wl[j].s1 = kv[(c >> 8) & 15] * dl;
+                    wl[j].s2 = kv[(c >> 16) & 15] * dl; wl[j].s3 = kv[(c >> 24) & 15] * dl;
+                    wh[j].s0 = kv[(c >> 4) & 15] * dl;  wh[j].s1 = kv[(c >> 12) & 15] * dl;
+                    wh[j].s2 = kv[(c >> 20) & 15] * dl; wh[j].s3 = kv[(c >> 28) & 15] * dl;
+                }
+                for (int t = 0; t < T; t++) {
+                    const float4 xl = vload4(0, xs + t * 256 + b * 32 + 4 * i);
+                    const float4 xh = vload4(0, xs + t * 256 + b * 32 + 16 + 4 * i);
+                    for (int j = 0; j < R; j++) {
+                        acc[j][t] = fma(wl[j].s0, xl.s0, fma(wl[j].s1, xl.s1, fma(wl[j].s2, xl.s2, fma(wl[j].s3, xl.s3, acc[j][t]))));
+                        acc[j][t] = fma(wh[j].s0, xh.s0, fma(wh[j].s1, xh.s1, fma(wh[j].s2, xh.s2, fma(wh[j].s3, xh.s3, acc[j][t]))));
+                    }
+                }
+            }
+        }
+    }
+    for (int j = 0; j < R; j++) {
+        const int row = ((int) get_group_id(0) * R + j) * 64 + lid;
+        if (row < nr) for (int t = 0; t < T; t++) Y[(size_t) t * nr + row] = acc[j][t];
+    }
+}
+)CLC";
