new file mode 100644
index 0000000..06cc2d1
--- /dev/null
+++ b/ggml/src/ggml-cpu/q4s-verify.inc
@@ -0,0 +1,234 @@
+// SR-HPM v4 / F3: small-batch verification kernel for Q4_0 weights on AVX2 (no VNNI).
+//
+// Opt-in with GGML_Q4S=1. At load time a Q4_0 tensor is repacked in place:
+//   per row, codes: for each 64 columns, 32 bytes, low nibble = column c (first Q4_0 block),
+//                   high nibble = column 32 + c (second block)            -> K/2 bytes
+//            int16 sub-scale per 32-column block, relative to the max |d| of its 256-column
+//                   super-block (14-bit, overflow-free)                    -> K/32 * 2 bytes
+//   (exactly the Q4_0 row size), plus a side table per (row, super-block): fp32 super-scale and
+//   the fp32 offset term of the unsigned-activation formulation (~5% extra memory).
+// Activations are quantized per token and 256-column super-block to u8 = q + 128.
+// Per 64 weights and token: 2 vpmaddubsw + 2 vpmaddwd (sub-scale applied in the integer domain);
+// one float FMA per super-block and token. Each weight row is read once for up to 4 tokens.
+#if defined(__AVX2__)
+
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace ggml::cpu::repack {
+
+static constexpr int Q4S_SB = 256;
+static constexpr int Q4S_DQMAX = 16383;
+
+struct q4s_side {
+    std::vector<float> S;    // N x nsb : super-scale / Q4S_DQMAX
+    std::vector<float> off;  // N x nsb : -128 * S * sum_b dq_b * sum_k (code_k - 8)
+};
+
+static std::mutex                                   q4s_mtx;
+static std::unordered_map<const void *, q4s_side *> q4s_sides;
+
+static bool q4s_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_Q4S");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+static inline float q4s_hsum(__m256 v) {
+    __m128 s = _mm_add_ps(_mm256_castps256_ps128(v), _mm256_extractf128_ps(v, 1));
+    s        = _mm_add_ps(s, _mm_movehl_ps(s, s));
+    s        = _mm_add_ss(s, _mm_movehdup_ps(s));
+    return _mm_cvtss_f32(s);
+}
+
+static void q4s_quantize_row(const float * x, uint8_t * u, float * sx, int64_t K) {
+    const __m256 sgn = _mm256_set1_ps(-0.f);
+    for (int64_t b = 0; b < K / Q4S_SB; b++) {
+        const float * xb = x + b * Q4S_SB;
+        __m256        mx = _mm256_setzero_ps();
+        for (int i = 0; i < Q4S_SB; i += 8) {
+            mx = _mm256_max_ps(mx, _mm256_andnot_ps(sgn, _mm256_loadu_ps(xb + i)));
+        }
+        __m128 m4 = _mm_max_ps(_mm256_castps256_ps128(mx), _mm256_extractf128_ps(mx, 1));
+        m4        = _mm_max_ps(m4, _mm_movehl_ps(m4, m4));
+        m4        = _mm_max_ss(m4, _mm_movehdup_ps(m4));
+        const float amax = _mm_cvtss_f32(m4);
+        const float sc = amax / 127.f, inv = sc > 0 ? 1.f / sc : 0.f;
+        const __m256 vinv = _mm256_set1_ps(inv);
+        uint8_t *    ub   = u + b * Q4S_SB;
+        for (int i = 0; i < Q4S_SB; i += 8) {
+            __m256i q = _mm256_cvtps_epi32(_mm256_mul_ps(_mm256_loadu_ps(xb + i), vinv));
+            q         = _mm256_add_epi32(q, _mm256_set1_epi32(128));
+            __m128i p16 = _mm_packus_epi32(_mm256_castsi256_si128(q), _mm256_extracti128_si256(q, 1));
+            _mm_storel_epi64((__m128i *) (ub + i), _mm_packus_epi16(p16, p16));
+        }
+        sx[b] = sc;
+    }
+}
+
+// one weight row x T tokens (T compile-time) -> T outputs
+template <int T>
+static inline void q4s_row(const uint8_t * codes, const int16_t * dq, const float * S, const float * off,
+                           const uint8_t * const * xu, const float * const * xs, int64_t K, float * out) {
+    const __m256i mask = _mm256_set1_epi8(0x0F), eight = _mm256_set1_epi8(8);
+    const int64_t nsb  = K / Q4S_SB;
+    __m256        f[T];
+    float         o[T];
+    for (int i = 0; i < T; i++) {
+        f[i] = _mm256_setzero_ps();
+        o[i] = 0.f;
+    }
+    for (int64_t sb = 0; sb < nsb; sb++) {
+        __m256i acc[T];
+        for (int i = 0; i < T; i++) {
+            acc[i] = _mm256_setzero_si256();
+        }
+        for (int c = 0; c < Q4S_SB / 64; c++) {
+            const int64_t col = sb * Q4S_SB + c * 64;
+            __m256i       v   = _mm256_loadu_si256((const __m256i *) (codes + col / 2));
+            __m256i       lo  = _mm256_sub_epi8(_mm256_and_si256(v, mask), eight);
+            __m256i       hi  = _mm256_sub_epi8(_mm256_and_si256(_mm256_srli_epi16(v, 4), mask), eight);
+            __m256i       da  = _mm256_set1_epi16(dq[col / 32]);
+            __m256i       db  = _mm256_set1_epi16(dq[col / 32 + 1]);
+            for (int i = 0; i < T; i++) {
+                __m256i x0 = _mm256_loadu_si256((const __m256i *) (xu[i] + col));
+                __m256i x1 = _mm256_loadu_si256((const __m256i *) (xu[i] + col + 32));
+                acc[i] = _mm256_add_epi32(acc[i], _mm256_add_epi32(_mm256_madd_epi16(_mm256_maddubs_epi16(x0, lo), da),
+                                                                   _mm256_madd_epi16(_mm256_maddubs_epi16(x1, hi), db)));
+            }
+        }
+        for (int i = 0; i < T; i++) {
+            const float sx = xs[i][sb];
+            f[i] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(acc[i]), _mm256_set1_ps(S[sb] * sx), f[i]);
+            o[i] += sx * off[sb];
+        }
+    }
+    for (int i = 0; i < T; i++) {
+        out[i] = q4s_hsum(f[i]) + o[i];
+    }
+}
+
+class tensor_traits_q4s : public tensor_traits_base {
+    bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const int64_t K = op->src[1]->ne[0], M = ggml_nrows(op->src[1]);
+        size            = GGML_PAD(M * K, 64) + M * (K / Q4S_SB) * sizeof(float) + 64;
+        return true;
+    }
+
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        GGML_ASSERT(src1->type == GGML_TYPE_F32);
+        GGML_ASSERT(src1->ne[2] == 1 && src1->ne[3] == 1 && op->ne[2] == 1 && op->ne[3] == 1);
+        const int64_t K = src0->ne[0], N = src0->ne[1], M = src1->ne[1];
+        const int64_t nsb = K / Q4S_SB;
+        const int     ith = params->ith, nth = params->nth;
+
+        uint8_t * xu = (uint8_t *) params->wdata;
+        float *   xs = (float *) ((char *) params->wdata + GGML_PAD(M * K, 64));
+        for (int64_t m = ith; m < M; m += nth) {
+            q4s_quantize_row((const float *) ((const char *) src1->data + m * src1->nb[1]), xu + m * K, xs + m * nsb, K);
+        }
+        ggml_barrier(params->threadpool);
+
+        q4s_side * side;
+        {
+            std::lock_guard<std::mutex> lk(q4s_mtx);
+            side = q4s_sides.at(src0->data);
+        }
+        const size_t  row_bytes = src0->nb[1];
+        const int64_t per = (N + nth - 1) / nth;
+        const int64_t n0 = ith * per, n1 = std::min<int64_t>(N, n0 + per);
+        for (int64_t n = n0; n < n1; n++) {
+            const uint8_t * codes = (const uint8_t *) src0->data + n * row_bytes;
+            const int16_t * dq    = (const int16_t *) (codes + K / 2);
+            const float *   S     = side->S.data() + n * nsb;
+            const float *   off   = side->off.data() + n * nsb;
+            int64_t m0 = 0;
+            float   out[4];
+            const uint8_t * xp[4];
+            const float *   sp[4];
+            auto store = [&](int T) {
+                for (int i = 0; i < T; i++) {
+                    ((float *) ((char *) op->data + (m0 + i) * op->nb[1]))[n] = out[i];
+                }
+            };
+            auto ptrs = [&](int T) {
+                for (int i = 0; i < T; i++) {
+                    xp[i] = xu + (m0 + i) * K;
+                    sp[i] = xs + (m0 + i) * nsb;
+                }
+            };
+            for (; m0 + 4 <= M; m0 += 4) { ptrs(4); q4s_row<4>(codes, dq, S, off, xp, sp, K, out); store(4); }
+            const int64_t rem = M - m0;  // one pass over the row for the remainder as well
+            if (rem == 3) { ptrs(3); q4s_row<3>(codes, dq, S, off, xp, sp, K, out); store(3); }
+            if (rem == 2) { ptrs(2); q4s_row<2>(codes, dq, S, off, xp, sp, K, out); store(2); }
+            if (rem == 1) { ptrs(1); q4s_row<1>(codes, dq, S, off, xp, sp, K, out); store(1); }
+        }
+        return true;
+    }
+
+    int repack(struct ggml_tensor * t, const void * data, size_t data_size) override {
+        GGML_ASSERT(t->type == GGML_TYPE_Q4_0);
+        const int64_t K = t->ne[0], N = t->ne[1], nsb = K / Q4S_SB, nb32 = K / 32;
+        const size_t  row_bytes = nb32 * sizeof(block_q4_0);
+        GGML_ASSERT(data_size == (size_t) N * row_bytes);
+        auto * side = new q4s_side();
+        side->S.resize(N * nsb);
+        side->off.resize(N * nsb);
+        std::vector<uint8_t> row(row_bytes);
+        for (int64_t n = 0; n < N; n++) {
+            const block_q4_0 * src   = (const block_q4_0 *) ((const char *) data + n * row_bytes);
+            uint8_t *          codes = row.data();
+            int16_t *          dq    = (int16_t *) (row.data() + K / 2);
+            for (int64_t sb = 0; sb < nsb; sb++) {
+                float smax = 0.f;
+                for (int b = 0; b < Q4S_SB / 32; b++) {
+                    smax = std::max(smax, fabsf(GGML_CPU_FP16_TO_FP32(src[sb * 8 + b].d)));
+                }
+                const float Sq = smax > 0 ? smax / Q4S_DQMAX : 1.f;
+                long long   acc = 0;
+                for (int b = 0; b < Q4S_SB / 32; b++) {
+                    const block_q4_0 & blk = src[sb * 8 + b];
+                    const int q = (int) lrintf(GGML_CPU_FP16_TO_FP32(blk.d) / Sq);
+                    dq[sb * 8 + b] = (int16_t) std::max(-Q4S_DQMAX, std::min(Q4S_DQMAX, q));
+                    long long s = 0;
+                    for (int j = 0; j < 16; j++) {
+                        s += (blk.qs[j] & 15) - 8 + (blk.qs[j] >> 4) - 8;
+                    }
+                    acc += s * dq[sb * 8 + b];
+                }
+                // codes: pairs of Q4_0 blocks -> 64 columns
+                for (int pb = 0; pb < Q4S_SB / 64; pb++) {
+                    const block_q4_0 & A = src[sb * 8 + 2 * pb];
+                    const block_q4_0 & B = src[sb * 8 + 2 * pb + 1];
+                    uint8_t *          o = codes + (sb * Q4S_SB + pb * 64) / 2;
+                    for (int c = 0; c < 32; c++) {
+                        const uint8_t a = c < 16 ? (A.qs[c] & 15) : (A.qs[c - 16] >> 4);
+                        const uint8_t bq = c < 16 ? (B.qs[c] & 15) : (B.qs[c - 16] >> 4);
+                        o[c] = (uint8_t) (a | (bq << 4));
+                    }
+                }
+                side->S[n * nsb + sb]   = Sq;
+                side->off[n * nsb + sb] = -128.f * Sq * (float) acc;
+            }
+            memcpy((char *) t->data + n * row_bytes, row.data(), row_bytes);
+        }
+        std::lock_guard<std::mutex> lk(q4s_mtx);
+        q4s_sides[t->data] = side;
+        return 0;
+    }
+};
+
+}  // namespace ggml::cpu::repack
+
+#endif  // __AVX2__
