+// OpenCL entry points, loaded from OpenCL.dll
+struct srv_cl_api {
+    decltype(&clGetPlatformIDs)          GetPlatformIDs;
+    decltype(&clGetDeviceIDs)            GetDeviceIDs;
+    decltype(&clGetDeviceInfo)           GetDeviceInfo;
+    decltype(&clCreateContext)           CreateContext;
+    decltype(&clCreateCommandQueue)      CreateCommandQueue;
+    decltype(&clCreateProgramWithSource) CreateProgramWithSource;
+    decltype(&clBuildProgram)            BuildProgram;
+    decltype(&clGetProgramBuildInfo)     GetProgramBuildInfo;
+    decltype(&clCreateKernel)            CreateKernel;
+    decltype(&clCreateBuffer)            CreateBuffer;
+    decltype(&clSetKernelArg)            SetKernelArg;
+    decltype(&clEnqueueWriteBuffer)      EnqueueWriteBuffer;
+    decltype(&clEnqueueReadBuffer)       EnqueueReadBuffer;
+    decltype(&clEnqueueNDRangeKernel)    EnqueueNDRangeKernel;
+    decltype(&clFlush)                   Flush;
+    decltype(&clFinish)                  Finish;
+    decltype(&clReleaseMemObject)        ReleaseMemObject;
+    decltype(&clEnqueueMapBuffer)        EnqueueMapBuffer;
+    decltype(&clEnqueueUnmapMemObject)   EnqueueUnmapMemObject;
+    decltype(&clGetEventProfilingInfo)   GetEventProfilingInfo;
+    decltype(&clReleaseEvent)            ReleaseEvent;
+};
+
+struct srv_igpu_tensor {
+    cl_mem  buf  = nullptr;                              // interleaved copy in driver-allocated host memory
+    int64_t rows = 0;                                    // rows in the copy (a multiple of 64, from row 0)
+};
+
+struct srv_igpu_t {
+    bool              ok = false;
+    srv_cl_api        cl{};
+    cl_context        ctx = nullptr;
+    cl_command_queue  q   = nullptr;
+    cl_device_id      dev = nullptr;
+    std::mutex        mtx;
+    std::map<std::tuple<int, int, int>, cl_kernel>    kernels;  // (kind, T, R)
+    std::unordered_map<const void *, srv_igpu_tensor> tensors;  // weights pointer -> interleaved copy
+    // activations and results in zero-copy host memory (written / read by the CPU directly): only the launch and one
+    // clFinish per call cross the driver (a copy each way cost ~1.8 ms per call)
+    cl_mem            xbuf = nullptr, ybuf = nullptr;
+    float *           xhost = nullptr, * yhost = nullptr;
+    size_t            xcap = 0, ycap = 0;
+
+    cl_mem host_buffer(size_t bytes, float *& p, cl_mem_flags fl) {
+        p = (float *) _aligned_malloc(bytes, 4096);
+        cl_int err;
+        cl_mem b = cl.CreateBuffer(ctx, fl | CL_MEM_USE_HOST_PTR, bytes, p, &err);
+        return err == CL_SUCCESS ? b : nullptr;
+    }
+    float             frac[17] = {};                            // share of the rows given to the iGPU, by tokens
+
+    srv_igpu_t() {
+        const char * e = getenv("GGML_SRV_IGPU");
+        if (!e || e[0] != '1') {
+            return;
+        }
+        // GGML_SRV_IGPU_FRAC="f1,f2,...": share of rows per number of tokens (default: none up to 4, then 0.45..0.55)
+        const float def[17] = { 0, 0, 0, 0, 0, 0.45f, 0.50f, 0.50f, 0.55f, 0.55f, 0.55f, 0.55f, 0.55f, 0.55f, 0.55f, 0.55f, 0.55f };
+        memcpy(frac, def, sizeof(frac));
+        if (const char * f = getenv("GGML_SRV_IGPU_FRAC")) {
+            int m = 1;
+            for (const char * p = f; *p && m <= 16; m++) {
+                frac[m] = (float) atof(p);
+                while (*p && *p != ',') p++;
+                if (*p == ',') p++;
+            }
+            for (; m <= 16; m++) frac[m] = frac[m - 1];
+        }
+        HMODULE lib = LoadLibraryA("OpenCL.dll");
+        if (!lib) {
+            fprintf(stderr, "srv_igpu: OpenCL.dll not found, disabled\n");
+            return;
+        }
+#define SRV_CL_LOAD(name) cl.name = (decltype(cl.name)) GetProcAddress(lib, "cl" #name); if (!cl.name) { fprintf(stderr, "srv_igpu: no cl" #name "\n"); return; }
+        SRV_CL_LOAD(GetPlatformIDs) SRV_CL_LOAD(GetDeviceIDs) SRV_CL_LOAD(GetDeviceInfo) SRV_CL_LOAD(CreateContext)
+        SRV_CL_LOAD(CreateCommandQueue) SRV_CL_LOAD(CreateProgramWithSource) SRV_CL_LOAD(BuildProgram)
+        SRV_CL_LOAD(GetProgramBuildInfo) SRV_CL_LOAD(CreateKernel) SRV_CL_LOAD(CreateBuffer) SRV_CL_LOAD(SetKernelArg)
+        SRV_CL_LOAD(EnqueueWriteBuffer) SRV_CL_LOAD(EnqueueReadBuffer) SRV_CL_LOAD(EnqueueNDRangeKernel) SRV_CL_LOAD(Flush)
+        SRV_CL_LOAD(Finish) SRV_CL_LOAD(ReleaseMemObject) SRV_CL_LOAD(EnqueueMapBuffer) SRV_CL_LOAD(EnqueueUnmapMemObject) SRV_CL_LOAD(GetEventProfilingInfo) SRV_CL_LOAD(ReleaseEvent)
+#undef SRV_CL_LOAD
+        cl_uint np = 0;
+        if (cl.GetPlatformIDs(0, nullptr, &np) != CL_SUCCESS || np == 0) return;
+        std::vector<cl_platform_id> ps(np);
+        cl.GetPlatformIDs(np, ps.data(), nullptr);
+        for (auto p : ps) {
+            cl_device_id d;
+            cl_uint      nd = 0;
+            cl_bool      um = 0;
+            if (cl.GetDeviceIDs(p, CL_DEVICE_TYPE_GPU, 1, &d, &nd) == CL_SUCCESS && nd) {
+                cl.GetDeviceInfo(d, CL_DEVICE_HOST_UNIFIED_MEMORY, sizeof(um), &um, nullptr);
+                if (um) {
+                    dev = d;  // the integrated GPU: it shares the host memory
+                }
+            }
+        }
+        if (!dev) {
+            fprintf(stderr, "srv_igpu: no integrated GPU, disabled\n");
+            return;
+        }
+        char name[256] = {};
+        cl.GetDeviceInfo(dev, CL_DEVICE_NAME, sizeof(name), name, nullptr);
+        cl_int err;
+        ctx = cl.CreateContext(nullptr, 1, &dev, nullptr, nullptr, &err);
+        if (err != CL_SUCCESS) return;
+        q = cl.CreateCommandQueue(ctx, dev, getenv("GGML_SRV_IGPU_PROF") ? CL_QUEUE_PROFILING_ENABLE : 0, &err);
+        if (err != CL_SUCCESS) return;
+        ok = true;
+        fprintf(stderr, "srv_igpu: %s, row shares by tokens 5-8: %.2f %.2f %.2f %.2f\n", name, frac[5], frac[6], frac[7], frac[8]);
+    }
+
+    cl_kernel kernel(int kind, int T, int R) {
+        auto it = kernels.find({ kind, T, R });
+        if (it != kernels.end()) return it->second;
+        cl_int     err;
+        cl_program prog = cl.CreateProgramWithSource(ctx, 1, &srv_igpu_src, nullptr, &err);
+        const std::string opt = "-cl-fast-relaxed-math -D KIND=" + std::to_string(kind) + " -D T=" + std::to_string(T) + " -D R=" + std::to_string(R);
+        cl_kernel k = nullptr;
+        if (cl.BuildProgram(prog, 1, &dev, opt.c_str(), nullptr, nullptr) != CL_SUCCESS) {
+            char log[4096] = {};
+            cl.GetProgramBuildInfo(prog, dev, CL_PROGRAM_BUILD_LOG, sizeof(log) - 1, log, nullptr);
+            fprintf(stderr, "srv_igpu: build failed: %s\n", log);
+        } else {
+            k = cl.CreateKernel(prog, "mv", &err);
+        }
+        kernels[{ kind, T, R }] = k;
+        return k;
+    }
+
+    // interleaved copy of the first `rows` rows (a multiple of 64; the last group padded with its last row)
+    srv_igpu_tensor * tensor(const void * w, int64_t N, int64_t nsb, size_t bs, int64_t rows) {
+        auto it = tensors.find(w);
+        if (it != tensors.end()) return it->second.buf ? &it->second : nullptr;
+        srv_igpu_tensor & t = tensors[w];
+        const int64_t ng    = (rows + 63) / 64;
+        const size_t  bytes = (size_t) ng * 64 * nsb * bs;
+        static size_t total = 0;
+        // CL_MEM_ALLOC_HOST_PTR: host memory the iGPU reads in place (38 GB/s). With CL_MEM_USE_HOST_PTR on our own
+        // allocation the driver kept a shadow copy, about 3x the commit charge of the copy itself.
+        cl_int err;
+        t.buf = cl.CreateBuffer(ctx, CL_MEM_READ_ONLY | CL_MEM_ALLOC_HOST_PTR, bytes, nullptr, &err);
+        uint8_t * base = t.buf ? (uint8_t *) cl.EnqueueMapBuffer(q, t.buf, CL_TRUE, CL_MAP_WRITE, 0, bytes, 0, nullptr, nullptr, &err) : nullptr;
+        if (!t.buf || !base) {
+            fprintf(stderr, "srv_igpu: no memory for a %.1f MB copy (%.2f GB so far), tensor stays on the CPU\n", bytes / 1e6, total / 1e9);
+            if (t.buf) cl.ReleaseMemObject(t.buf);
+            t.buf = nullptr;
+            return nullptr;
+        }
+        total += bytes;
+        if (getenv("GGML_SRV_IGPU_DEBUG")) {
+            fprintf(stderr, "srv_igpu: copy %lld rows x %lld super-blocks x %zu B = %.1f MB (total %.2f GB)\n", (long long) rows,
+                    (long long) nsb, bs, bytes / 1e6, total / 1e9);
+        }
+        const uint8_t * src = (const uint8_t *) w;
+        for (int64_t g = 0; g < ng; g++)
+            for (int64_t ib = 0; ib < nsb; ib++)
+                for (int64_t l = 0; l < 64; l++) {
+                    const int64_t r = std::min<int64_t>(std::min<int64_t>(N, rows) - 1, g * 64 + l);
+                    memcpy(base + ((g * nsb + ib) * 64 + l) * bs, src + (r * nsb + ib) * bs, bs);
+                }
+        cl.EnqueueUnmapMemObject(q, t.buf, base, 0, nullptr, nullptr);
+        cl.Finish(q);
+        t.rows = std::min<int64_t>(N, ng * 64);
+        return &t;
+    }
+
+    // launch the iGPU part: rows [0, nr) of y = W x for M tokens; returns false if it could not
+    bool launch(int kind, const void * w, size_t bs, int64_t N, int64_t K, int64_t M, int64_t nr, const float * x, size_t x_nb1) {
+        const int64_t nsb = K / 256;
+        // the copy covers the largest share used for this tensor
+        float fmax = 0;
+        for (int m = 1; m <= 16; m++) fmax = std::max(fmax, frac[m]);
+        const int64_t rmax = std::min<int64_t>(N, ((int64_t) (fmax * N) + 63) / 64 * 64);
+        srv_igpu_tensor * t = tensor(w, N, nsb, bs, rmax);
+        if (!t || nr > t->rows) return false;
+        // rows per work-item: more reuse of the staged activations, but enough waves to hide memory latency
+        const int64_t ngr = (nr + 63) / 64;
+        const int R = ngr < 64 ? 1 : (M <= 4 || ngr < 160) ? 2 : 4;
+        cl_kernel k = kernel(kind, (int) M, R);
+        if (!k) return false;
+        const size_t xb = (size_t) M * K * sizeof(float), yb = (size_t) M * nr * sizeof(float);
+        // activations in a device buffer: every work-group re-reads all of them (T x K floats), which from zero-copy
+        // host memory bypassed the GPU caches and made the kernel 5x slower in the model; results stay zero-copy
+        cl_int err;
+        if (xb > xcap) {
+            if (xbuf) cl.ReleaseMemObject(xbuf);
+            xcap = std::max(xb, (size_t) 16 * 17408 * sizeof(float));
+            xbuf = cl.CreateBuffer(ctx, CL_MEM_READ_ONLY, xcap, nullptr, &err);
+        }
+        if (yb > ycap) {
+            if (ybuf) { cl.ReleaseMemObject(ybuf); _aligned_free(yhost); }
+            ycap = std::max(yb, (size_t) 16 * 32768 * sizeof(float));
+            ybuf = host_buffer(ycap, yhost, CL_MEM_WRITE_ONLY);
+        }
+        if (!xbuf || !ybuf) return false;
+        for (int64_t m = 0; m < M; m++) {
+            cl.EnqueueWriteBuffer(q, xbuf, CL_FALSE, m * K * sizeof(float), K * sizeof(float), (const char *) x + m * x_nb1, 0, nullptr, nullptr);
+        }
+        const int insb = (int) nsb, iK = (int) K, inr = (int) nr;
+        cl.SetKernelArg(k, 0, sizeof(cl_mem), &t->buf);
+        cl.SetKernelArg(k, 1, sizeof(cl_mem), &xbuf);
+        cl.SetKernelArg(k, 2, sizeof(cl_mem), &ybuf);
+        cl.SetKernelArg(k, 3, sizeof(int), &insb);
+        cl.SetKernelArg(k, 4, sizeof(int), &iK);
+        cl.SetKernelArg(k, 5, sizeof(int), &inr);
+        const size_t ng = (size_t) (nr + 63) / 64, lws = 64, gws = (ng + R - 1) / R * 64;
+        t_launch = std::chrono::steady_clock::now();
+        static const bool prof = getenv("GGML_SRV_IGPU_PROF") != nullptr;
+        if (cl.EnqueueNDRangeKernel(q, k, 1, nullptr, &gws, &lws, 0, nullptr, prof ? &ev : nullptr) != CL_SUCCESS) return false;
+        prof_bytes += (double) nr * nsb * bs;
+        cl.Flush(q);
+        return true;
+    }
+
+    // wait for the iGPU part and write it into dst (rows [0, nr) of the M output rows)
+    // GGML_SRV_IGPU_PROF=1: per call, the time from launch to when thread 0 had finished its CPU rows and the extra
+    // time it then waited for the iGPU, printed every 500 calls
+    std::chrono::steady_clock::time_point t_launch;
+    double prof_cpu = 0, prof_wait = 0, prof_bytes = 0, prof_exec = 0, prof_queued = 0;
+    cl_event ev = nullptr;
+    long long prof_n = 0;
+
+    void collect(int64_t M, int64_t nr, char * dst, size_t dst_nb1) {
+        static const bool prof = getenv("GGML_SRV_IGPU_PROF") != nullptr;
+        const auto t0 = std::chrono::steady_clock::now();
+        cl.Finish(q);
+        const auto t1 = std::chrono::steady_clock::now();
+        for (int64_t m = 0; m < M; m++) {
+            memcpy(dst + m * dst_nb1, yhost + m * nr, nr * sizeof(float));
+        }
+        if (prof && ev) {
+            cl_ulong qd = 0, st = 0, en = 0;
+            cl.GetEventProfilingInfo(ev, CL_PROFILING_COMMAND_QUEUED, sizeof(qd), &qd, nullptr);
+            cl.GetEventProfilingInfo(ev, CL_PROFILING_COMMAND_START, sizeof(st), &st, nullptr);
+            cl.GetEventProfilingInfo(ev, CL_PROFILING_COMMAND_END, sizeof(en), &en, nullptr);
+            prof_exec   += (en - st) * 1e-9;
+            prof_queued += (st - qd) * 1e-9;
+            cl.ReleaseEvent(ev);
+            ev = nullptr;
+        }
+        if (prof) {
+            prof_cpu  += std::chrono::duration<double>(t0 - t_launch).count();
+            prof_wait += std::chrono::duration<double>(t1 - t0).count();
+            if (++prof_n % 500 == 0) {
+                fprintf(stderr, "srv_igpu_prof: %lld calls, per call: launch->CPU rows done %.3f ms, then waited for the iGPU %.3f ms;"
+                        " kernel queued->start %.3f ms, executing %.3f ms (%.1f GB/s)\n",
+                        prof_n, prof_cpu / prof_n * 1e3, prof_wait / prof_n * 1e3, prof_queued / prof_n * 1e3, prof_exec / prof_n * 1e3,
+                        prof_bytes / prof_exec / 1e9);
+            }
+        }
+    }
+};
