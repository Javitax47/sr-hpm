+// SR-HPM (GGML_CUDA_KEEPALIVE=<us>): in a hybrid CPU+GPU pass the GPU is idle most of the time and the driver drops
+// it to a low-power clock between its short bursts of work. A host thread keeps one warp busy with back-to-back
+// spin kernels of <us> microseconds on a lowest-priority stream, so the GPU stays in its high-performance state;
+// the real kernels preempt nothing and lose at most one SM warp slot.
+static __global__ void srhpm_keepalive_kernel(long long cycles) {
+    const long long t0 = clock64();
+    while (clock64() - t0 < cycles) {
+    }
+}
+
+static void srhpm_keepalive_start(int device) {
+    static std::once_flag once;
+    std::call_once(once, [device] {
+        const char * e = getenv("GGML_CUDA_KEEPALIVE");
+        const int    us = e ? atoi(e) : 0;
+        if (us <= 0) {
+            return;
+        }
+        std::thread([device, us] {
+            ggml_cuda_set_device(device);
+            int lo = 0, hi = 0;
+            CUDA_CHECK(cudaDeviceGetStreamPriorityRange(&lo, &hi));
+            cudaStream_t stream;
+            CUDA_CHECK(cudaStreamCreateWithPriority(&stream, cudaStreamNonBlocking, lo));
+            int khz = 0;
+            CUDA_CHECK(cudaDeviceGetAttribute(&khz, cudaDevAttrClockRate, device));
+            const long long cycles = (long long) khz * us / 1000;
+            for (;;) {
+                srhpm_keepalive_kernel<<<1, 32, 0, stream>>>(cycles);
+                if (cudaStreamSynchronize(stream) != cudaSuccess) {
+                    return;
+                }
+            }
+        }).detach();
+        GGML_LOG_INFO("%s: GPU keepalive on device %d, %d us spin kernels\n", __func__, device, us);
+    });
+}
