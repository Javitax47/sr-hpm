+// SR-HPM: small-batch (speculative verification) kernels for the K/IQ types of "dynamic" low-bit GGUFs
+// (IQ4_XS, IQ3_S, IQ3_XXS, Q3_K) on AVX2 without VNNI. Opt-in with GGML_SRV=1.
+//
+// llama.cpp computes these types with one vec_dot per (row, token): every 32-weight block is decoded
+// again for every token, so verifying M tokens costs ~M times the decode work and the M = 4 pass is
+// 2-3x the M = 1 pass. Here each block is decoded once into |w| (u8) and a sign carrier, and then
+// multiplied with up to 8 tokens:
+//   per 32 weights and token: vpsignb + vpmaddubsw + vpmaddwd (integer block scale) + vpaddd
+//   per 256 weights and token: one float FMA (super-block scale x activation scale).
+// Weights keep their native layout (the "repack" is a copy), so batches larger than SRV_MAXM fall
+// back to the stock path. Activations are quantized per token and 256 columns to int8, like Q8_K.
+#if defined(__AVX2__)
+
+#include "srv-kernels.inc"
+#include "srv-igpu.inc"
+#include "srv-dgpu.inc"
+
+#include <atomic>
+#include <string>
+#include <chrono>
+#include <mutex>
+#include <type_traits>
+#include <unordered_map>
+#include <vector>
+
+namespace ggml::cpu::repack {
+
+// GGML_SRV_PROF=1: wall time of thread 0 inside the SRV kernels (quantization, its rows, until it runs out of
+// chunks), per type and batch size, with the bytes of the weights read: printed at exit and every 20000 calls
+struct srv_prof_t {
+    std::atomic<long long> ns[10][SRV_MAXM + 1] = {};
+    std::atomic<long long> calls[10][SRV_MAXM + 1] = {};
+    std::atomic<long long> bytes[10][SRV_MAXM + 1] = {};
+    std::atomic<long long> total_calls{0};
+    bool on = [] { const char * e = getenv("GGML_SRV_PROF"); return e && e[0] == '1'; }();
+    void dump() {
+        static const char * names[10] = { "IQ4_XS", "IQ3_S", "IQ3_XXS", "Q3_K", "IQ2_XXS", "IQ2_XS", "IQ2_S", "Q6_K", "Q4_K", "Q5_K" };
+        for (int t = 0; t < 10; t++) {
+            for (int m = 1; m <= SRV_MAXM; m++) {
+                if (calls[t][m]) {
+                    fprintf(stderr, "srv_prof %-8s M=%-2d calls %8lld  total %8.3f s  per call %8.1f us  %6.1f GB/s\n", names[t], m,
+                            calls[t][m].load(), ns[t][m] / 1e9, ns[t][m] / 1e3 / calls[t][m], (double) bytes[t][m] / ns[t][m]);
+                }
+            }
+        }
+    }
+    ~srv_prof_t() {
+        if (on) dump();
+    }
+};
+static srv_prof_t srv_prof;
+
+template <class D> constexpr int srv_type_id = -1;
+template <> constexpr int srv_type_id<srv_iq4_xs>  = 0;
+template <> constexpr int srv_type_id<srv_iq3_s>   = 1;
+template <> constexpr int srv_type_id<srv_iq3_xxs> = 2;
+template <> constexpr int srv_type_id<srv_q3_k>    = 3;
+template <> constexpr int srv_type_id<srv_iq2_xxs> = 4;
+template <> constexpr int srv_type_id<srv_iq2_xs>  = 5;
+template <> constexpr int srv_type_id<srv_iq2_s>   = 6;
+template <> constexpr int srv_type_id<srv_q6_k>    = 7;
+template <> constexpr int srv_type_id<srv_q45_k<false>> = 8;
+template <> constexpr int srv_type_id<srv_q45_k<true>>  = 9;
+
+static constexpr int64_t SRV_CHUNK = 16;  // rows per dynamically scheduled chunk
+
+// side buffers of re-encoded (C4) weights, keyed by the tensor data pointer
+static std::mutex                                                 srv_side_mtx;
+static std::unordered_map<const void *, std::vector<block_srv_c4> *> srv_side;
+
+// GGML_SRV_PAIR=0: plain IQ4_XS kernel instead of the paired one (bit-identical to ggml's vec_dot; the paired
+// kernel sums in another order, ~1e-7 relative)
+static bool srv_pair_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_SRV_PAIR");
+        return !e || e[0] != '0';
+    }();
+    return on;
+}
+
+// GGML_SRV_PAIR=2: pair C4 as well (measured: no gain in the model, -6 % to +4 % within the noise)
+static bool srv_pair_c4_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_SRV_PAIR");
+        return e && e[0] == '2';
+    }();
+    return on;
+}
+
+// GGML_SRV_OFF=1: offset path (no per-token sign step) for the types that allow it, see srv-kernels.inc
+static bool srv_off_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_SRV_OFF");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+static bool srv_c4_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_SRV_C4");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+// D: native block type and decoder; R: decoder the kernel runs on (R = D, or a C4 re-encoding of D kept in a
+// side buffer, while the native copy stays in the tensor for the large-batch stock path)
+template <class R, class = void> struct srv_igpu_kind : std::integral_constant<int, -1> {};
+template <class R> struct srv_igpu_kind<R, std::enable_if_t<std::is_same<typename R::block, block_iq4_xs>::value>>
+    : std::integral_constant<int, 0> {};
+template <class R> struct srv_igpu_kind<R, std::enable_if_t<std::is_same<typename R::block, block_srv_c4>::value>>
+    : std::integral_constant<int, 1 + R::kind> {};
+
+// native block types the dGPU kernels read (srv-dgpu.inc): 0 = IQ4_XS, 1 = Q3_K
+template <class D, class = void> struct srv_dgpu_kind : std::integral_constant<int, -1> {};
+template <class D> struct srv_dgpu_kind<D, std::enable_if_t<std::is_same<typename D::block, block_iq4_xs>::value>>
+    : std::integral_constant<int, 0> {};
+template <class D> struct srv_dgpu_kind<D, std::enable_if_t<std::is_same<typename D::block, block_q3_K>::value>>
+    : std::integral_constant<int, 1> {};
+
+#if defined(_WIN32)
+static std::atomic<int64_t> srv_dgpu_rows{0};  // rows of the current matrix product handed to the dGPU
+static std::atomic<int64_t> srv_igpu_rows{0};  // rows of the current matrix product handed to the iGPU
+#endif
+
+template <class D, class R = D>
+class tensor_traits_srv : public tensor_traits_base {
+    static constexpr bool side = !std::is_same<typename D::block, typename R::block>::value;
+    bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
+        if (op->op != GGML_OP_MUL_MAT || ggml_nrows(op->src[1]) > SRV_MAXM) {
+            return false;
+        }
+        const int64_t K = op->src[1]->ne[0], M = ggml_nrows(op->src[1]);
+        size            = GGML_PAD(M * K, 64) + GGML_PAD(M * (K / QK_K) * sizeof(float), 64) + GGML_PAD(M * (K / 32) * sizeof(int16_t), 64) +
+                          M * (K / 16) * sizeof(int16_t) + 64;
+        return true;
+    }
+
+    static constexpr bool can_off = srv_off<R>::value > 0;
+
+    template <int T>
+    static void tile(const typename R::block * row, int64_t nsb, const int8_t * xq, const float * xs, const int16_t * xb,
+                     const int16_t * x16, int64_t K, int64_t m0, float * out) {
+        const int8_t *  xp[T];
+        const float *   sp[T];
+        const int16_t * bp[T];
+        const int16_t * b16[T];
+        for (int t = 0; t < T; t++) {
+            xp[t]  = xq + (m0 + t) * K;
+            sp[t]  = xs + (m0 + t) * (K / QK_K);
+            bp[t]  = xb + (m0 + t) * (K / 32);
+            b16[t] = x16 + (m0 + t) * (K / 16);
+        }
+        if constexpr (can_off) {
+            if (srv_off_enabled()) {
+                srv_row<R, T, true>(row, nsb, xp, sp, out, bp, b16);
+                return;
+            }
+        }
+        srv_row<R, T>(row, nsb, xp, sp, out, bp);
+    }
+
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT || ggml_nrows(op->src[1]) > SRV_MAXM) {
+            return false;  // large batches: stock path on the unchanged layout
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        GGML_ASSERT(src1->type == GGML_TYPE_F32);
+        GGML_ASSERT(src1->ne[2] == 1 && src1->ne[3] == 1 && op->ne[2] == 1 && op->ne[3] == 1);
+        const int64_t K = src0->ne[0], N = src0->ne[1], M = src1->ne[1];
+        const int64_t nsb = K / QK_K;
+        const int     ith = params->ith, nth = params->nth;
+        const auto    t_start = srv_prof.on && ith == 0 ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point();
+
+        // GGML_SRV_DUMP=<file>: thread 0 appends a sample of the f32 activations of multi-token calls
+        // (header: M, K, type id; then M x K floats), for offline analysis of cross-token structure
+        static FILE * dump = [] {
+            const char * e = getenv("GGML_SRV_DUMP");
+            return e ? fopen(e, "ab") : (FILE *) nullptr;
+        }();
+        if (dump && ith == 0 && M >= 4) {
+            static int ncall = 0, ndump = 0;
+            if (ncall++ % 23 == 0 && ndump < 400) {
+                ndump++;
+                const int32_t hdr[3] = { (int32_t) M, (int32_t) K, srv_type_id<D> };
+                fwrite(hdr, sizeof(hdr), 1, dump);
+                for (int64_t m = 0; m < M; m++) {
+                    fwrite((const char *) src1->data + m * src1->nb[1], sizeof(float), K, dump);
+                }
+                fflush(dump);
+            }
+        }
+        // GGML_SRV_DUMP_NAMES=<file>,<tensor>,<tensor>...: every decode call (M <= 8) of the named weights appends
+        // its input rows (header: layer, M, K), one record per verification pass, to pair with SRHPM_LATTICE_LOG
+        static FILE * dumpn = [] {
+            const char * e = getenv("GGML_SRV_DUMP_NAMES");
+            return e ? fopen(std::string(e, strcspn(e, ",")).c_str(), "ab") : (FILE *) nullptr;
+        }();
+        if (dumpn && ith == 0 && M <= 8) {
+            static const std::string names = std::string(",") + getenv("GGML_SRV_DUMP_NAMES") + ",";
+            if (names.find(std::string(",") + src0->name + ",") != std::string::npos) {
+                int layer = -1;
+                sscanf(src0->name, "blk.%d.", &layer);
+                const int32_t hdr[3] = { layer, (int32_t) M, (int32_t) K };
+                fwrite(hdr, sizeof(hdr), 1, dumpn);
+                for (int64_t m = 0; m < M; m++) {
+                    fwrite((const char *) src1->data + m * src1->nb[1], sizeof(float), K, dumpn);
+                }
+                fflush(dumpn);
+            }
+        }
+        int8_t * xq = (int8_t *) params->wdata;
+        float *   xs = (float *) ((char *) params->wdata + GGML_PAD(M * K, 64));
+        int16_t * xb  = (int16_t *) ((char *) xs + GGML_PAD(M * nsb * sizeof(float), 64));
+        int16_t * x16 = (int16_t *) ((char *) xb + GGML_PAD(M * (K / 32) * sizeof(int16_t), 64));
+        const bool off = can_off && srv_off_enabled();
+        for (int64_t m = ith; m < M; m += nth) {
+            srv_quantize_row((const float *) ((const char *) src1->data + m * src1->nb[1]), xq + m * K, xs + m * nsb, K,
+                             srv_has_min<R>::value ? xb + m * (K / 32) : nullptr, off ? x16 + m * (K / 16) : nullptr);
+            if constexpr (srv_paired<R>::value) {
+                srv_permute_pairs(xq + m * K, K);
+            }
+        }
+        const typename R::block * base;
+        if constexpr (side) {
+            // built at load time by repack(); when the buffer is host-accessible the loader writes the tensor
+            // data directly and repack() is skipped, so the first use builds it (once, under the lock)
+            std::lock_guard<std::mutex> lk(srv_side_mtx);
+            auto it = srv_side.find(src0->data);
+            if (it == srv_side.end()) {
+                it = srv_side.emplace(src0->data, build_side(src0->data, ggml_nbytes(src0))).first;
+            }
+            base = it->second->data();
+        } else {
+            base = (const typename R::block *) src0->data;
+            GGML_ASSERT(src0->nb[1] == (size_t) nsb * sizeof(typename R::block));
+        }
+
+        // SR-HPM iGPU: thread 0 hands the first rows to the integrated GPU (srv-igpu.inc) before the CPU threads start
+        int64_t r0 = 0;
+#if defined(_WIN32)
+        constexpr int igpu_kind = srv_igpu_kind<R>::value;
+        if constexpr (igpu_kind >= 0) {
+            if (ith == 0) {
+                int64_t     nr = 0;
+                srv_igpu_t & g = srv_igpu();
+                // C4 tensors go to the iGPU only with GGML_SRV_IGPU_C4=1 (their interleaved copy costs commit memory)
+                static const bool c4_on = [] { const char * e = getenv("GGML_SRV_IGPU_C4"); return e && e[0] == '1'; }();
+                if (g.ok && M <= 16 && g.frac[M] > 0 && (igpu_kind == 0 || c4_on)) {
+                    std::lock_guard<std::mutex> lk(g.mtx);
+                    nr = std::min<int64_t>(N, (int64_t) (g.frac[M] * N) / 64 * 64);
+                    if (nr > 0 && !g.launch(igpu_kind, base, sizeof(typename R::block), N, K, M, nr, (const float *) src1->data, src1->nb[1])) {
+                        nr = 0;
+                    }
+                }
+                srv_igpu_rows.store(nr, std::memory_order_relaxed);
+            }
+        }
+        // SR-HPM dGPU: same scheme with the discrete GPU reading pinned copies of the rows over PCIe (srv-dgpu.inc)
+        constexpr int dgpu_kind = srv_dgpu_kind<D>::value;
+        if constexpr (dgpu_kind >= 0 && !side) {
+            if (ith == 0) {
+                int64_t      nr = 0;
+                srv_dgpu_t & g  = srv_dgpu();
+                if (g.ok && M <= 8 && srv_igpu_rows.load(std::memory_order_relaxed) == 0) {
+                    nr = (int64_t) (g.frac[M] * N) / 4 * 4;
+                    if (nr > 0 && g.launch(dgpu_kind, src0->data, src0->data, nr, K, (int) M, (const float *) src1->data,
+                                           src1->nb[1], g.max_pinned) != 0) {
+                        nr = 0;
+                    }
+                }
+                srv_dgpu_rows.store(nr, std::memory_order_relaxed);
+            }
+        }
+#endif
+        // chunks of rows handed out dynamically: 16 threads on 8 SMT cores do not progress evenly
+        if (ith == 0) {
+            ggml_threadpool_chunk_set(params->threadpool, nth);
+        }
+        ggml_barrier(params->threadpool);
+#if defined(_WIN32)
+        if constexpr (igpu_kind >= 0) {
+            r0 = srv_igpu_rows.load(std::memory_order_relaxed);
+        }
+        int64_t r_dgpu = 0;
+        if constexpr (dgpu_kind >= 0 && !side) {
+            r_dgpu = srv_dgpu_rows.load(std::memory_order_relaxed);
+            r0     = std::max(r0, r_dgpu);
+        }
+#endif
+        const int64_t nchunk = (N - r0 + SRV_CHUNK - 1) / SRV_CHUNK;
+
+        float out[8];
+        for (int64_t chunk = ith; chunk < nchunk; chunk = ggml_threadpool_chunk_add(params->threadpool, 1)) {
+        const int64_t n1 = std::min<int64_t>(N, r0 + (chunk + 1) * SRV_CHUNK);
+        for (int64_t n = r0 + chunk * SRV_CHUNK; n < n1; n++) {
+            const typename R::block * row = base + n * nsb;
+            int64_t      m0  = 0;
+            auto store = [&](int T) {
+                for (int t = 0; t < T; t++) {
+                    ((float *) ((char *) op->data + (m0 + t) * op->nb[1]))[n] = out[t];
+                }
+            };
+            for (; m0 + 8 <= M; m0 += 8) { tile<8>(row, nsb, xq, xs, xb, x16, K, m0, out); store(8); }
+            switch (M - m0) {  // one pass over the row for the remainder as well
+                case 7: tile<7>(row, nsb, xq, xs, xb, x16, K, m0, out); store(7); break;
+                case 6: tile<6>(row, nsb, xq, xs, xb, x16, K, m0, out); store(6); break;
+                case 5: tile<5>(row, nsb, xq, xs, xb, x16, K, m0, out); store(5); break;
+                case 4: tile<4>(row, nsb, xq, xs, xb, x16, K, m0, out); store(4); break;
+                case 3: tile<3>(row, nsb, xq, xs, xb, x16, K, m0, out); store(3); break;
+                case 2: tile<2>(row, nsb, xq, xs, xb, x16, K, m0, out); store(2); break;
+                case 1: tile<1>(row, nsb, xq, xs, xb, x16, K, m0, out); store(1); break;
+                default: break;
+            }
+        }
+        }
+#if defined(_WIN32)
+        if (r_dgpu > 0 && ith == 0) {
+            srv_dgpu().collect((int) M, r_dgpu, (char *) op->data, op->nb[1]);
+        } else if (r0 > 0 && ith == 0) {
+            srv_igpu_t & g = srv_igpu();
+            std::lock_guard<std::mutex> lk(g.mtx);
+            g.collect(M, r0, (char *) op->data, op->nb[1]);
+        }
+#endif
+        if (srv_prof.on && ith == 0) {
+            srv_prof.ns[srv_type_id<D>][M] += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t_start).count();
+            srv_prof.calls[srv_type_id<D>][M]++;
+            srv_prof.bytes[srv_type_id<D>][M] += (long long) ggml_nbytes(src0);
+            if (++srv_prof.total_calls % 20000 == 0) {
+                fprintf(stderr, "srv_prof ---- after %lld calls\n", srv_prof.total_calls.load());
+                srv_prof.dump();
+            }
+        }
+        // GGML_SRV_CHECK=1: thread 0 recomputes 4 rows with ggml's own vec_dot (Q8_K activations) and reports
+        // the worst relative difference per type (debugging aid)
+        static const bool check = [] { const char * e = getenv("GGML_SRV_CHECK"); return e && e[0] == '1'; }();
+        if (check) {
+            ggml_barrier(params->threadpool);
+            if (ith == 0) {
+                static double worst[10] = {};
+                static int    ncalls[10] = {};
+                const auto *  tt = ggml_get_type_traits_cpu(src0->type);
+                const auto *  qt = ggml_get_type_traits_cpu(tt->vec_dot_type);
+                std::vector<uint8_t> yq(ggml_row_size(tt->vec_dot_type, K));
+                double w = 0;
+                for (int64_t m = 0; m < M; m++) {
+                    qt->from_float((const float *) ((const char *) src1->data + m * src1->nb[1]), yq.data(), K);
+                    for (int64_t n = 0; n < std::min<int64_t>(N, 4); n++) {
+                        const int64_t r = n * (N / 4);
+                        float ref = 0;
+                        tt->vec_dot((int) K, &ref, 0, (const char *) src0->data + r * src0->nb[1], 0, yq.data(), 0, 1);
+                        const float got = ((const float *) ((const char *) op->data + m * op->nb[1]))[r];
+                        const double d = (double) fabsf(got - ref) / (fabsf(ref) + 1e-3);
+                        static int nbad = 0;
+                        if (d > 1e-3 && nbad++ < 12) {
+                            fprintf(stderr, "srv_bad %s M=%lld m=%lld row=%lld got %.6g ref %.6g src1 nb1=%zu ne1=%lld op nb1=%zu data=%p src1=%p\n",
+                                    ggml_type_name(src0->type), (long long) M, (long long) m, (long long) r, got, ref,
+                                    src1->nb[1], (long long) src1->ne[1], op->nb[1], op->data, src1->data);
+                        }
+                        w = std::max(w, d);
+                    }
+                }
+                const int id = srv_type_id<D>;
+                worst[id] = std::max(worst[id], w);
+                if (++ncalls[id] % 200 == 1) {
+                    fprintf(stderr, "srv_check %s calls %d worst rel diff %.3g (M=%lld K=%lld N=%lld)\n", ggml_type_name(src0->type),
+                            ncalls[id], worst[id], (long long) M, (long long) K, (long long) N);
+                }
+            }
+        }
+        return true;
+    }
+
+    int repack(struct ggml_tensor * t, const void * data, size_t data_size) override {
+        memcpy(t->data, data, data_size);  // native layout
+        if constexpr (side) {
+            auto * c4 = build_side(data, data_size);
+            std::lock_guard<std::mutex> lk(srv_side_mtx);
+            srv_side[t->data] = c4;
+        }
+        return 0;
+    }
+
+    static std::vector<block_srv_c4> * build_side(const void * data, size_t data_size) {
+        const int64_t nblk = (int64_t) (data_size / sizeof(typename D::block));
+        auto *        c4   = new std::vector<block_srv_c4>(nblk);
+        const auto *  src  = (const typename D::block *) data;
+        for (int64_t i = 0; i < nblk; i++) {
+            srv_to_c4<D, R::kind>(src + i, c4->data() + i);
+        }
+        return c4;
+    }
+};
+
+static const tensor_traits_base * srv_traits_for(const struct ggml_tensor * cur) {
+    if (!srv_enabled() || cur->ne[0] % QK_K != 0 || cur->ne[2] != 1 || cur->ne[3] != 1) {
+        return nullptr;
+    }
+    // GGML_SRV_TYPES=iq4_xs,iq3_s,... restricts the kernels to these types (default: all)
+    static const std::string srv_types = [] {
+        const char * e = getenv("GGML_SRV_TYPES");
+        return std::string(e ? e : "");
+    }();
+    if (!srv_types.empty() && ("," + srv_types + ",").find("," + std::string(ggml_type_name(cur->type)) + ",") == std::string::npos) {
+        return nullptr;
+    }
+    static tensor_traits_srv<srv_iq4_xs>  iq4_xs;
+    static tensor_traits_srv<srv_iq4_xs, srv_iq4_xs_p> iq4_xs_p;
+    static tensor_traits_srv<srv_iq3_s>   iq3_s;
+    static tensor_traits_srv<srv_iq3_xxs> iq3_xxs;
+    static tensor_traits_srv<srv_iq3_s, srv_c4<0>>   iq3_s_c4;
+    static tensor_traits_srv<srv_iq3_xxs, srv_c4<1>> iq3_xxs_c4;
+    static tensor_traits_srv<srv_iq3_s, srv_c4_p<0>>   iq3_s_c4p;
+    static tensor_traits_srv<srv_iq3_xxs, srv_c4_p<1>> iq3_xxs_c4p;
+    static tensor_traits_srv<srv_q3_k>    q3_k;
+    static tensor_traits_srv<srv_iq2_xxs> iq2_xxs;
+    static tensor_traits_srv<srv_iq2_xs>  iq2_xs;
+    static tensor_traits_srv<srv_iq2_s>   iq2_s;
+    static tensor_traits_srv<srv_q6_k>    q6_k;
+    static tensor_traits_srv<srv_q45_k<false>> q4_k;
+    static tensor_traits_srv<srv_q45_k<true>>  q5_k;
+    switch (cur->type) {
+        case GGML_TYPE_IQ4_XS:  return srv_pair_enabled() ? (const tensor_traits_base *) &iq4_xs_p : &iq4_xs;
