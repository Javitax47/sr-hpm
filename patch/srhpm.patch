+// SR-HPM (GGML_LARGE_PAGES=1): large CPU buffers (the model weights) on 2 MB pages. Streaming ~10 GB of weights
+// per token through 4 KB pages misses the TLB on most cache lines; large pages remove most of those walks.
+// Windows needs the "Lock pages in memory" right (SeLockMemoryPrivilege) granted to the account; Linux uses
+// transparent huge pages (madvise). Falls back to the normal allocation when unavailable.
+static const size_t GGML_LP_MIN_SIZE = 32u*1024*1024;
+
+static bool ggml_lp_requested() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_LARGE_PAGES");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+#if defined(_WIN32)
+static bool ggml_lp_enable_privilege() {
+    HANDLE token;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token)) {
+        return false;
+    }
+    TOKEN_PRIVILEGES tp = {};
+    tp.PrivilegeCount = 1;
+    tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    bool ok = LookupPrivilegeValueA(NULL, "SeLockMemoryPrivilege", &tp.Privileges[0].Luid) &&
+              AdjustTokenPrivileges(token, FALSE, &tp, 0, NULL, NULL) && GetLastError() == ERROR_SUCCESS;
+    CloseHandle(token);
+    return ok;
+}
+#endif
+
+// returns NULL when large pages are not available
+static void * ggml_lp_alloc(size_t size, size_t * alloc_size) {
+#if defined(_WIN32)
+    static const bool privileged = [] {
+        const bool ok = ggml_lp_enable_privilege();
+        GGML_LOG_INFO("large pages: %s\n", ok ? "SeLockMemoryPrivilege enabled"
+                                              : "not available (grant 'Lock pages in memory' to this account)");
+        return ok;
+    }();
+    const size_t lp = GetLargePageMinimum();
+    if (!privileged || lp == 0) {
+        return NULL;
+    }
+    const size_t sz = (size + lp - 1)/lp*lp;
+    void * p = VirtualAlloc(NULL, sz, MEM_RESERVE | MEM_COMMIT | MEM_LARGE_PAGES, PAGE_READWRITE);
+    if (p) {
+        *alloc_size = sz;
+    }
+    return p;
+#elif defined(__linux__)
+    const size_t hp = 2u*1024*1024;
+    const size_t sz = (size + hp - 1)/hp*hp;
+    void * p = NULL;
+    if (posix_memalign(&p, hp, sz) != 0) {
+        return NULL;
+    }
+    madvise(p, sz, MADV_HUGEPAGE);
+    *alloc_size = sz;
+    return p;
+#else
+    GGML_UNUSED(size);
+    GGML_UNUSED(alloc_size);
+    return NULL;
+#endif
+}
+
+static void ggml_backend_cpu_buffer_free_buffer_lp(ggml_backend_buffer_t buffer) {
+    GGML_ASSERT(buffer);
+#if defined(_WIN32)
+    VirtualFree(buffer->context, 0, MEM_RELEASE);
+#else
+    free(buffer->context);
+#endif
+}
