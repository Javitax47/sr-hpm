+
+// scratch of the grouped path (also used by ggml_graph_plan); 0 when it does not apply
+size_t ggml_fa_gqa_small_work_size(const ggml_tensor * op, int n_threads) {
+    const ggml_tensor * q = op->src[0];
+    const ggml_tensor * k = op->src[1];
+    const ggml_tensor * v = op->src[2];
+    if (q->ne[1] < 2 || q->ne[1] > FA_GQA_MAX_N || k->ne[2] == 0 || q->ne[2] % k->ne[2] != 0) {
+        return 0;
+    }
+    const int64_t DK = k->ne[0], DV = v->ne[0], R = (q->ne[2]/k->ne[2])*q->ne[1];
+    const int64_t KVT = GGML_FA_TILE_KV;
+    int64_t len;
+    const int64_t n_chunks = ggml_fa_gqa_n_chunks(k->ne[1], k->ne[2], n_threads, &len);
+    const int64_t per_thread = R*DK + 2*R*KVT + R*DV + KVT*DV + KVT*DK + CACHE_LINE_SIZE_F32;
+    return sizeof(float)*(n_threads*per_thread + k->ne[2]*R*n_chunks*(2 + DV)) + CACHE_LINE_SIZE;
