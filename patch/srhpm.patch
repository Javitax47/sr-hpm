+// SR-HPM (SRHPM_FA_GQA=1): attention for a few query tokens (speculative verification) with GQA grouping.
+// The stock paths handle such batches row by row: each (token, head) row converts every K/V row of the cache
+// from f16 and does its own dot products, so with GQA the rows that share a KV head (6 heads x 4 tokens for
+// Qwen3.8) repeat the same conversions and loads. Here one tile holds all the rows of a GQA group, each K/V
+// block is converted once and multiplied as a small GEMM, and the KV cache is split into chunks across threads
+// (online softmax per chunk, then a per-row reduction), so that a handful of groups still fills the CPU.
+static bool ggml_fa_gqa_small_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("SRHPM_FA_GQA");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+static constexpr int64_t FA_GQA_MAX_N = 8;  // query tokens handled by the grouped path
+
+static int64_t ggml_fa_gqa_n_chunks(int64_t nek1, int64_t n_groups, int nth, int64_t * chunk_len) {
+    const int64_t KVT = GGML_FA_TILE_KV;
+    int64_t n_chunks  = std::max<int64_t>(1, (2*nth + n_groups - 1)/n_groups);
+    n_chunks          = std::min<int64_t>(n_chunks, (nek1 + KVT - 1)/KVT);
+    int64_t len       = (nek1 + n_chunks - 1)/n_chunks;
+    len               = ((len + KVT - 1)/KVT)*KVT;
+    *chunk_len        = len;
+    return (nek1 + len - 1)/len;
